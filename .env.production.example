# Copy this file to .env.production only on the server. Never commit the copy.
# Keep passwords URL-safe: letters, numbers, hyphen and underscore only.
POSTGRES_USER=sagalab
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=sagalab
RABBITMQ_DEFAULT_USER=sagalab
RABBITMQ_DEFAULT_PASS=replace-with-a-long-url-safe-password

# The public HTTP port of the API. TLS/reverse proxy is a separate hardening step.
SAGALAB_API_PORT=80
